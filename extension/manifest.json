{
  "manifest_version": 3,
  "name": "TTS Host Selection Reader",
  "version": "0.1.0",
  "description": "Speak the selected text on the current page with TTS Host.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service_worker.js" },
  "action": { "default_title": "Read selected text" },
  "options_page": "options.html"
}
