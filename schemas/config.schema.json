{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTS Host Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "server",
    "audio",
    "modelRegistry",
    "profiles",
    "languageDefaults"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "authentication",
        "allowedOrigins"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "authentication": {
          "type": "string",
          "enum": [
            "none",
            "automatic",
            "token"
          ]
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputDevice"
      ],
      "properties": {
        "outputDevice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directories",
        "watchForChanges",
        "idleUnloadSeconds",
        "maximumLoadedGpuModels"
      ],
      "properties": {
        "directories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "watchForChanges": {
          "type": "boolean"
        },
        "idleUnloadSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "maximumLoadedGpuModels": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_-]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "device",
            "loadPolicy"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            },
            "loadPolicy": {
              "type": "string",
              "enum": [
                "eager",
                "onDemand"
              ]
            }
          }
        }
      }
    },
    "languageDefaults": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
